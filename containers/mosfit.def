# Lean MOSFiT runtime image for the OSG plugin.
# MOSFiT (guillochon fork: offline local-only fetcher, in-package filters) plus
# emcee/dynesty. ZTF (Palomar/ZTF.{g,r,i}) transmission curves are baked in so
# ZTF-band fits never touch the network on a worker. The plugin ships
# mosfit_wrapper.py + mosfit_bridge.py per-job, so this image is a generic MOSFiT
# runtime (no plugin code baked in).
#
#   apptainer build --fakeroot --mksquashfs-args "-processors 1" mosfit.sif mosfit.def
#
# Install the fork, NOT PyPI mosfit: only the fork's fetcher runs offline.
Bootstrap: docker
From: ubuntu:24.04

%post
    set -e
    export PIP_BREAK_SYSTEM_PACKAGES=1 DEBIAN_FRONTEND=noninteractive
    apt-get update
    # openmpi so mosfit's mpi4py dependency builds and imports (the fit itself
    # runs single-process via schwimmbad's SerialPool).
    apt-get install -y python3 python3-pip git build-essential curl \
        libopenmpi-dev openmpi-bin
    apt-get clean && rm -rf /var/lib/apt/lists/*

    pip3 install uv
    # numpy<2 (astropy compat) and pandas<3 per MOSFiT's pins.
    uv pip install --system --break-system-packages \
        "numpy>=1.23,<=1.26.4" "pandas>=2.1,<3" \
        git+https://github.com/guillochon/MOSFiT.git

    # Bake ZTF transmission curves into the installed package so ZTF-band fits
    # resolve filters locally (Palomar/ZTF.{g,r,i}); otherwise MOSFiT would try
    # an SVO download at runtime, which fails in the sandbox.
    FILTERS=$(python3 -c "import mosfit, os; print(os.path.join(os.path.dirname(mosfit.__file__), 'modules', 'observables', 'filters'))")
    for b in g r i; do
        curl -fsSL "http://svo2.cab.inta-csic.es/svo/theory/fps3/fps.php?PhotCalID=Palomar/ZTF.${b}/AB" \
            -o "$FILTERS/Palomar_ZTF.${b}_AB.xml"
    done

    # Fail the build if the runtime or a baked filter is missing.
    python3 -c "import mosfit, emcee, dynesty; from mosfit.fitter import Fitter; print('mosfit ok')"
    for b in g r i; do
        test -s "$FILTERS/Palomar_ZTF.${b}_AB.xml" || { echo "missing baked ZTF ${b} filter"; exit 1; }
    done

%runscript
    exec python3 "$@"
