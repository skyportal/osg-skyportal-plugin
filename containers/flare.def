# FLARE runtime .sif; models ship in the package, so rebuild only when FLARE or its deps change.
#   apptainer build --fakeroot --mksquashfs-args "-processors 1" flare.sif flare.def
Bootstrap: docker
From: python:3.12-slim

%post
    set -e
    export PIP_BREAK_SYSTEM_PACKAGES=1 DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends git build-essential && apt-get clean && rm -rf /var/lib/apt/lists/*
    pip3 install --no-cache-dir "git+https://github.com/applecider-ml/flare" jax requests
    # Fail the build if the classify entrypoint (flare.skyportal, which imports
    # jax) isn't importable or the models don't load -- from_pretrained alone
    # doesn't exercise the jax path, which is what the plugin actually calls.
    python3 -c "import flare.skyportal; from flare.hierarchical import HierarchicalFlare; from flare.config import BTS6; HierarchicalFlare.from_pretrained(BTS6); print('flare ok')"

%runscript
    exec python3 "$@"
